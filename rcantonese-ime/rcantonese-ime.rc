LANGUAGE 0x09, 0x01

1 VERSIONINFO
 FILEVERSION 0,9,3,0
 PRODUCTVERSION 0,9,3,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x3L
 FILESUBTYPE 0xbL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0404b0"
        BEGIN
            VALUE "FileDescription", "R-Cantonese"
            VALUE "FileVersion", "0.9.3"
            VALUE "ProductName", "R-Cantonese"
            VALUE "ProductVersion", "0.9.3"
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "R-Cantonese"
            VALUE "FileVersion", "0.9.3"
            VALUE "ProductName", "R-Cantonese"
            VALUE "ProductVersion", "0.9.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c04, 0x04b0
    END
END
